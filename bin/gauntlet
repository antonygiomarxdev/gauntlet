#!/usr/bin/env bash
# gauntlet: a code-quality ratchet. Entry point; libraries live in lib/.
set -eu

# shellcheck source=lib/core.sh
. "$(dirname "$0")/../lib/core.sh"
# shellcheck source=lib/rules.sh
. "$(dirname "$0")/../lib/rules.sh"
# shellcheck source=lib/paths.sh
. "$(dirname "$0")/../lib/paths.sh"
# shellcheck source=lib/detect.sh
. "$(dirname "$0")/../lib/detect.sh"
# shellcheck source=lib/measure.sh
. "$(dirname "$0")/../lib/measure.sh"
# shellcheck source=lib/cases.sh
. "$(dirname "$0")/../lib/cases.sh"
# shellcheck source=lib/base.sh
. "$(dirname "$0")/../lib/base.sh"
# shellcheck source=lib/exceptions.sh
. "$(dirname "$0")/../lib/exceptions.sh"
# shellcheck source=lib/check.sh
. "$(dirname "$0")/../lib/check.sh"

case "${1:-}" in
  --version) printf 'gauntlet %s\n' "$GAUNTLET_VERSION" ;;
  base)
    # Outside a repo, repo_root exits 2 before any lookup can fall back to main.
    repo_root >/dev/null
    if [ -n "${2:-}" ]; then
      branch=$(current_branch)
      if [ "$branch" = HEAD ]; then die "detached HEAD: check out a branch first"; fi
      git config "branch.$branch.gauntletBase" "$2"
    else
      resolve_base ""
    fi
    ;;
  baseline)
    root=$(repo_root) || exit 2
    scratch=$(mktemp -d) || exit 2
    status=0
    measure all "$scratch" || status=$?
    if [ "$status" -eq 0 ]; then
      cp "$scratch/measure.tsv" "$root/.gauntlet/baseline.tsv" || status=2
    fi
    rm -rf "$scratch"
    exit "$status"
    ;;
  test-rules)
    root=$(repo_root) || exit 2
    status=0
    run_rule_tests "$root" || status=$?
    exit "$status"
    ;;
  waive)
    shift
    status=0
    exc_waive "$@" || status=$?
    exit "$status"
    ;;
  loosen)
    shift
    status=0
    exc_loosen "$@" || status=$?
    exit "$status"
    ;;
  remove)
    shift
    status=0
    exc_remove "$@" || status=$?
    exit "$status"
    ;;
  check)
    shift
    status=0
    case "${1:-}" in
      --staged) shift; check_staged "$@" || status=$? ;;
      *) check_ci "$@" || status=$? ;;
    esac
    exit "$status"
    ;;
  *) die "unknown command: ${1:-}" ;;
esac
